{
  "name": "mirai-sales-pipeline",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "営業パイプライン・受注予測管理（Cloudflare Workers + Neon Postgres + React/Vite）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "node --import tsx src/dev-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "vite build --config web/vite.config.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "build:all": "npm run build:web && npm run build:worker",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "deploy": "npm run build:all && node scripts/deploy.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^9.39.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.0",
    "wrangler": "^4.121.0"
  }
}
