# ==== 環境変数（ローカル開発・デプロイ用） ====
# 実際の値は .env（git管理外）に設定する。本番値は Cloudflare Worker Secrets / Neon コンソールで管理。

# Neon PostgreSQL 接続文字列（pooler / HTTP SQL エンドポイント対応ホスト）
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-example-pooler.REGION.aws.neon.tech/neondb

# テスト用 DB（統合テスト時のみ）
DATABASE_URL_TEST=

# セッション署名用秘密鍵（openssl rand -hex 32 で生成）
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# 定期処理（cron）呼び出し用共通秘密鍵
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32

# デプロイ対象
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API トークン（Workers Scripts: Edit 権限。Git 管理外 / CI では Secret で管理）
CLOUDFLARE_API_TOKEN=
WORKER_NAME=mirai-sales-pipeline
ENVIRONMENT=production

# シード実行時のみ: デモユーザーの初期パスワード（未設定かつ本番環境の場合は seed が失敗する）
SEED_DEMO_PASSWORD=
